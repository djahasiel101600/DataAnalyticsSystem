# Django production settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
DJANGO_SECURE_SSL_REDIRECT=1
# Enable HSTS only after HTTPS is confirmed for this hostname.
DJANGO_SECURE_HSTS_SECONDS=0

# Optional server-side AI feature. Leave blank to disable it.
OPENAI_API_KEY=

# Optional Google Drive Picker identifiers. These are embedded in the frontend
# build, so they are public browser configuration, not private secrets.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=
